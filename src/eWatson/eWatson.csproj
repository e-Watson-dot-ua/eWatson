<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- This is the only packable project -->
    <IsPackable>true</IsPackable>
    <PackageId>eWatson</PackageId>
    <Version>1.1.2</Version>
    <PackageDescription>eWatson foundational domain building blocks for .NET applications. Includes entities, value objects, guards, results pattern, and persistence abstractions.</PackageDescription>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Include all project assemblies in the single package -->
    <ProjectReference Include="..\eWatson.Abstractions\eWatson.Abstractions.csproj" PrivateAssets="All" />
    <ProjectReference Include="..\eWatson.Persistence.Abstractions\eWatson.Persistence.Abstractions.csproj" PrivateAssets="All" />
    <ProjectReference Include="..\eWatson.Primitives\eWatson.Primitives.csproj" PrivateAssets="All" />
    <ProjectReference Include="..\eWatson.Entities\eWatson.Entities.csproj" PrivateAssets="All" />
    <ProjectReference Include="..\eWatson.Guards\eWatson.Guards.csproj" PrivateAssets="All" />
    <ProjectReference Include="..\eWatson.ValueObjects\eWatson.ValueObjects.csproj" PrivateAssets="All" />
    <ProjectReference Include="..\eWatson.Mediator.Abstractions\eWatson.Mediator.Abstractions.csproj" PrivateAssets="All" />
    <ProjectReference Include="..\eWatson.Mediator\eWatson.Mediator.csproj" PrivateAssets="All" />
    <ProjectReference Include="..\eWatson.Mediator.Persistence\eWatson.Mediator.Persistence.csproj" PrivateAssets="All" />
    <ProjectReference Include="..\eWatson.Events\eWatson.Events.csproj" PrivateAssets="All" />
  </ItemGroup>

  <!-- Declare runtime dependencies that must be pulled transitively by consumers -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <!-- Include all referenced project DLLs and XML docs in the package -->
  <PropertyGroup>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);CopyProjectReferencesToPackage</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>

  <Target Name="CopyProjectReferencesToPackage">
    <ItemGroup>
      <!-- Include DLLs from all project references (they're copied to our bin folder) -->
      <BuildOutputInPackage Include="$(OutputPath)eWatson.Abstractions.dll" />
      <BuildOutputInPackage Include="$(OutputPath)eWatson.Persistence.Abstractions.dll" />
      <BuildOutputInPackage Include="$(OutputPath)eWatson.Guards.dll" />
      <BuildOutputInPackage Include="$(OutputPath)eWatson.Primitives.dll" />
      <BuildOutputInPackage Include="$(OutputPath)eWatson.Entities.dll" />
      <BuildOutputInPackage Include="$(OutputPath)eWatson.ValueObjects.dll" />
      <BuildOutputInPackage Include="$(OutputPath)eWatson.Mediator.Abstractions.dll" />
      <BuildOutputInPackage Include="$(OutputPath)eWatson.Mediator.dll" />
      <BuildOutputInPackage Include="$(OutputPath)eWatson.Mediator.Persistence.dll" />
      <BuildOutputInPackage Include="$(OutputPath)eWatson.Events.dll" />
      <!-- Include XML documentation files -->
      <BuildOutputInPackage Include="$(OutputPath)eWatson.Abstractions.xml" />
      <BuildOutputInPackage Include="$(OutputPath)eWatson.Persistence.Abstractions.xml" />
      <BuildOutputInPackage Include="$(OutputPath)eWatson.Guards.xml" />
      <BuildOutputInPackage Include="$(OutputPath)eWatson.Primitives.xml" />
      <BuildOutputInPackage Include="$(OutputPath)eWatson.Entities.xml" />
      <BuildOutputInPackage Include="$(OutputPath)eWatson.ValueObjects.xml" />
      <BuildOutputInPackage Include="$(OutputPath)eWatson.Mediator.Abstractions.xml" />
      <BuildOutputInPackage Include="$(OutputPath)eWatson.Mediator.xml" />
      <BuildOutputInPackage Include="$(OutputPath)eWatson.Mediator.Persistence.xml" />
      <BuildOutputInPackage Include="$(OutputPath)eWatson.Events.xml" />
    </ItemGroup>
  </Target>

</Project>
